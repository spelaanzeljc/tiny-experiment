{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Povio React Native mobile app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "oxlint --type-aware ",
    "lint:fix": "oxlint --type-aware  --fix",
    "lint:check": "oxlint --type-aware --type-check  --quiet",
    "format": "oxfmt -c \"oxfmt.config.js\"",
    "format:check": "oxfmt -c \"oxfmt.config.js\" --check",
    "test": "EXPO_OS=ios jest",
    "ts:check": "tsc --noEmit",
    "check": "bun ts:check && bun lint:check && bun format:check",
    "openapi:gen": "openapi-codegen generate --prettier false",
    "openapi:check": "openapi-codegen check",
    "generate": "bun run openapi:gen",
    "clean": "rimraf .turbo .expo/types"
  },
  "dependencies": {
    "@dev-plugins/react-query": "catalog:react-native",
    "@expo/vector-icons": "catalog:react-native",
    "@gorhom/bottom-sheet": "catalog:react-native",
    "@hookform/resolvers": "catalog:",
    "@povio/openapi-codegen-cli": "catalog:",
    "@povio/resolve-config": "catalog:",
    "@povio/rn-ui": "1.0.0",
    "@react-native-async-storage/async-storage": "catalog:react-native",
    "@react-native-community/datetimepicker": "catalog:react-native",
    "@react-native-community/slider": "catalog:react-native",
    "@sentry/react-native": "catalog:react-native",
    "@shopify/restyle": "catalog:react-native",
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "expo": "catalog:react-native",
    "expo-application": "catalog:react-native",
    "expo-blur": "catalog:react-native",
    "expo-constants": "catalog:react-native",
    "expo-device": "catalog:react-native",
    "expo-font": "catalog:react-native",
    "expo-image": "catalog:react-native",
    "expo-linear-gradient": "catalog:react-native",
    "expo-linking": "catalog:react-native",
    "expo-router": "catalog:react-native",
    "expo-secure-store": "catalog:react-native",
    "expo-splash-screen": "catalog:react-native",
    "expo-status-bar": "catalog:react-native",
    "fake-be": "workspace:*",
    "react": "catalog:react-native",
    "react-dom": "catalog:react-native",
    "react-hook-form": "catalog:",
    "react-native": "catalog:react-native",
    "react-native-gesture-handler": "catalog:react-native",
    "react-native-reanimated": "catalog:react-native",
    "react-native-safe-area-context": "catalog:react-native",
    "react-native-screens": "catalog:react-native",
    "react-native-svg": "catalog:react-native",
    "react-native-toastable": "catalog:react-native",
    "react-native-ui-datepicker": "catalog:react-native",
    "react-native-web": "catalog:react-native",
    "react-native-worklets": "catalog:react-native",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:react-native",
    "@expo/env": "catalog:react-native",
    "@react-native/jest-preset": "catalog:react-native",
    "@testing-library/jest-dom": "catalog:react-native",
    "@testing-library/react-native": "catalog:react-native",
    "@types/css": "catalog:react-native",
    "@types/invariant": "catalog:react-native",
    "@types/jest": "catalog:react-native",
    "@types/node": "^24.10.9",
    "@types/react": "catalog:react-native",
    "@typescript/native": "catalog:",
    "babel-jest": "catalog:react-native",
    "babel-preset-expo": "catalog:react-native",
    "cross-env": "catalog:react-native",
    "css": "catalog:react-native",
    "jest": "catalog:react-native",
    "jest-expo": "catalog:react-native",
    "nock": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "ts-jest": "catalog:react-native",
    "typescript": "catalog:"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
