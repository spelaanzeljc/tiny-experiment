{
  "name": "fe",
  "version": "0.0.0",
  "private": true,
  "description": "tiny frontend",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build && bun ../../scripts/generate-static-api-docs.ts",
    "start": "node ../../scripts/serve.mjs",
    "clean": "rimraf .turbo dist src/openapi",
    "lint": "cd ../.. && oxlint --type-aware apps/fe packages/fake-be/src --fix",
    "lint:check": "cd ../.. && oxlint --type-aware apps/fe packages/fake-be/src --quiet",
    "format": "cd ../.. && oxfmt -c \"oxfmt.config.js\" apps/fe packages/fake-be/src",
    "format:check": "cd ../.. && oxfmt -c \"oxfmt.config.js\" --check apps/fe packages/fake-be/src",
    "ts:check": "tsc -b --noEmit",
    "test": "vitest run",
    "check": "bun ts:check && bun lint:check && bun format:check",
    "orpc:openapi": "bun --filter fake-be openapi:gen",
    "openapi:gen": "bun orpc:openapi && openapi-codegen generate && oxfmt -c \"../../oxfmt.config.js\" ./src/openapi",
    "openapi:check": "bun orpc:openapi && openapi-codegen check",
    "i18n:missing": "bunx tsx ../../scripts/i18n/find-missing-translations.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@casl/react": "^5.0.1",
    "@dagrejs/dagre": "^2.0.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.11.0",
    "@orpc/contract": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@povio/openapi-codegen-cli": "catalog:",
    "@povio/resolve-config": "catalog:",
    "@povio/ui": "3.4.0-rc.12",
    "@sentry/react": "^10.38.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/react-devtools": "^0.8.1",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "~5.90.0",
    "@tanstack/react-router": "^1.136.8",
    "@tanstack/react-router-devtools": "^1.136.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-core": "^1.136.8",
    "@tanstack/router-plugin": "^1.136.8",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fake-be": "workspace:*",
    "i18next": "^25.7.3",
    "loglevel": "^1.9.2",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "react": "19.2.4",
    "react-aria": "^3.46.0",
    "react-aria-components": "^1.15.1",
    "react-dom": "19.2.4",
    "react-i18next": "^16.5.1",
    "serve": "^14.2.4",
    "serve-handler": "^6.1.6",
    "swagger-ui-dist": "^5.32.6",
    "web-vitals": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@povio/react-scan": "0.0.0",
    "@povio/spa-deploy-cli": "^4.2.2",
    "@povio/vite-plugin-react-scan": "0.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-dist": "^3.30.6",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.45.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "react-icons-sprite": "^1.1.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.2.4",
    "tailwindcss-react-aria-components": "^2.1.0",
    "tsx": "^4.22.1",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
