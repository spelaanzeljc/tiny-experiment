{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [".oxlint-base.json"],
  "plugins": ["eslint", "typescript", "unicorn", "import", "vitest", "react", "react-perf", "jsx-a11y"],
  "categories": {
    "style": "error"
  },
  "ignorePatterns": [
    "openapi-codegen.config.ts",
    "postcss.config.js",
    "out",
    "dist",
    "public",
    "scripts",
    ".vscode",
    ".turbo",
    "node_modules",
    "src/routeTree.gen.ts",
    "apps/fe/src/routeTree.gen.ts",
    "apps/fe/src/openapi",
    "apps/fe/src/openapi.generated.json",
    "apps/fe/public"
  ],
  "overrides": [
    {
      "files": ["src/fake-be/db/dbml-generator.ts", "apps/fake-be/src/db/dbml-generator.ts"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": ["vite-plugin-*.ts", "apps/fe/vite-plugin-*.ts"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    }
  ],
  "rules": {
    "eslint/no-implicit-coercion": "off",
    "no-map-spread": "off",
    "eslint/sort-keys": "off",
    "eslint/sort-imports": "off",
    "eslint/no-ternary": "off",
    "eslint/id-length": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/arrow-body-style": "off",
    "eslint/max-params": "off",
    "eslint/func-style": "off",
    "eslint/new-cap": "off",
    "eslint/no-continue": "off",
    "eslint/max-statements": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "react/exhaustive-deps": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-max-depth": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "typescript/no-empty-interface": "off",
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "import/prefer-default-export": "off",
    "import/exports-last": "off",
    "import/consistent-type-specifier-style": "off",
    "jest/require-hook": "off",
    "unicorn/filename-case": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-null": "off"
  }
}
