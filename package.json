{
  "name": "tiny-template-2",
  "version": "2.2.0",
  "private": true,
  "description": "tiny",
  "type": "module",
  "scripts": {
    "fe": "bun --filter fe",
    "mobile": "bun --filter mobile",
    "fake-be": "bun --filter fake-be",
    "dev": "bun --filter fe dev",
    "build": "bun --filter fe build",
    "start": "bun --filter fe start",
    "clean": "bun --filter fe clean",
    "lint": "bun --filter fe lint",
    "lint:check": "bun --filter fe lint:check",
    "format": "bun --filter fe format && bun --filter mobile format",
    "format:check": "bun --filter fe format:check && bun --filter mobile format:check",
    "rules:gen": "rulesync generate",
    "rules:check": "rulesync generate --check",
    "ts:check": "bun --filter fe ts:check",
    "test": "bun --filter fake-be test && bun --filter fe test",
    "check": "bun --filter fe check && bun --filter mobile check",
    "orpc:openapi": "bun --filter fe orpc:openapi",
    "openapi:gen": "bun --filter fe openapi:gen",
    "openapi:check": "bun --filter fe openapi:check",
    "i18n:missing": "bun --filter fe i18n:missing"
  },
  "devDependencies": {
    "@povio/openapi-codegen-cli": "catalog:",
    "rulesync": "^8.18.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/fe",
      "apps/mobile",
      "packages/fake-be"
    ],
    "catalog": {
      "@hookform/resolvers": "^5.2.2",
      "@povio/openapi-codegen-cli": "3.1.0",
      "@povio/resolve-config": "1.3.0",
      "@tanstack/react-query": "^5.90.21",
      "@typescript/native": "npm:typescript@^7.0.2",
      "axios": "^1.13.2",
      "nock": "^14.0.10",
      "oxfmt": "^0.45.0",
      "oxlint": "1.60.0",
      "oxlint-tsgolint": "0.21.0",
      "react-hook-form": "^7.65.0",
      "rimraf": "^6.1.2",
      "typescript": "npm:@typescript/typescript6@^6.0.2",
      "zod": "^4.4.3",
      "zustand": "^5.0.9"
    },
    "catalogs": {
      "react-native": {
        "@babel/core": "^7.29.7",
        "@dev-plugins/react-query": "^0.4.0",
        "@expo/env": "^2.3.0",
        "@expo/vector-icons": "^15.1.1",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-community/datetimepicker": "^9.1.0",
        "@react-native-community/slider": "^5.2.0",
        "@sentry/react-native": "^8.15.1",
        "@shopify/restyle": "^2.4.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react-native": "^14.0.0",
        "@types/css": "^0.0.38",
        "@types/invariant": "^2.2.37",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.2.17",
        "@react-native/jest-preset": "0.85.3",
        "babel-jest": "^29.7.0",
        "babel-preset-expo": "^56.0.15",
        "cross-env": "^10.1.0",
        "css": "^3.0.0",
        "expo": "^56.0.12",
        "expo-application": "^56.0.3",
        "expo-blur": "^56.0.3",
        "expo-constants": "^56.0.18",
        "expo-device": "^56.0.4",
        "expo-font": "^56.0.7",
        "expo-image": "^56.0.11",
        "expo-linear-gradient": "^56.0.4",
        "expo-linking": "^56.0.14",
        "expo-router": "^56.2.11",
        "expo-secure-store": "^56.0.4",
        "expo-splash-screen": "^56.0.10",
        "expo-status-bar": "^56.0.4",
        "jest": "^29.7.0",
        "jest-expo": "^56.0.5",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.85.3",
        "react-native-gesture-handler": "~2.31.2",
        "react-native-reanimated": "4.3.1",
        "react-native-safe-area-context": "^5.8.0",
        "react-native-screens": "^4.25.2",
        "react-native-svg": "^15.15.5",
        "react-native-toastable": "^1.0.6",
        "react-native-ui-datepicker": "^3.3.0",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "^0.8.3",
        "ts-jest": "^29.4.11"
      }
    }
  }
